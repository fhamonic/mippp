+/* Explicit checks remain active in Release builds where assert is disabled. */
+static void check_farkas(int condition)
+{
+   if(!condition)
+   {
+      fprintf(stderr, "Farkas C interface test failed\n");
+      abort();
+   }
+}
+
+void test_farkas(void)
+{
+   void* soplex = SoPlex_create();
+   double coefficient = 1.0;
+   double ray[2] = {123.0, 456.0};
+   const double infty = 1e100;
+   /* Disable simplification so infeasibility is detected by simplex. */
+   SoPlex_setIntParam(soplex, 10, 0);
+   SoPlex_addColReal(soplex, NULL, 0, 0, 0.0, -infty, infty);
+   SoPlex_addRowReal(soplex, &coefficient, 1, 1, 2.0, infty);
+   SoPlex_addRowReal(soplex, &coefficient, 1, 1, -infty, 1.0);
+   check_farkas(!SoPlex_hasDualFarkas(soplex));
+   check_farkas(!SoPlex_getDualFarkasReal(soplex, ray, 2));
+   check_farkas(SoPlex_optimize(soplex) == 3);
+   check_farkas(SoPlex_hasDualFarkas(soplex));
+   check_farkas(!SoPlex_hasDualFarkas(NULL));
+   check_farkas(!SoPlex_getDualFarkasReal(NULL, ray, 2));
+   check_farkas(!SoPlex_getDualFarkasReal(soplex, NULL, 2));
+   check_farkas(!SoPlex_getDualFarkasReal(soplex, ray, -1));
+   check_farkas(!SoPlex_getDualFarkasReal(soplex, ray, 1));
+   check_farkas(ray[0] == 123.0 && ray[1] == 456.0);
+   check_farkas(SoPlex_getDualFarkasReal(soplex, ray, 2));
+   check_farkas(ray[0] * ray[1] < 0.0);
+   SoPlex_changeRowRhsReal(soplex, 1, 3.0);
+   check_farkas(SoPlex_optimize(soplex) == 1);
+   check_farkas(!SoPlex_hasDualFarkas(soplex));
+   check_farkas(!SoPlex_getDualFarkasReal(soplex, ray, 2));
+   SoPlex_free(soplex);
+}
