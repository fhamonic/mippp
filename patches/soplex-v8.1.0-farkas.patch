+int SoPlex_hasDualFarkas(void* soplex)
+{
+   if(soplex == nullptr)
+      return 0;
+   SoPlex* so = (SoPlex*)(soplex);
+   return so->hasDualFarkas() ? 1 : 0;
+}
+
+int SoPlex_getDualFarkasReal(void* soplex, double* farkas, int dim)
+{
+   if(soplex == nullptr || farkas == nullptr || dim < 0)
+      return 0;
+   SoPlex* so = (SoPlex*)(soplex);
+   if(dim < so->numRows() || !so->hasDualFarkas())
+      return 0;
+   try
+   {
+      return so->getDualFarkasReal(farkas, dim) ? 1 : 0;
+   }
+   catch(...)
+   {
+      // Do not propagate extraction/allocation failures through the C ABI.
+      return 0;
+   }
+}
+
