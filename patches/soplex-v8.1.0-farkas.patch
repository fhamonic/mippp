+/** returns 1 if a Farkas certificate for the current LP is available, otherwise 0;
+ *  does not optimize the LP. A null handle returns 0.
+ **/
+int SoPlex_hasDualFarkas(void* soplex);
+
+/** copies the floating-point Farkas certificate in original row order into caller-owned storage;
+ *  returns 1 on success, 0 if unavailable, invalid arguments, or extraction fails.
+ *  dim must be at least the number of rows. No optimization is performed.
+ *  On failure the buffer must not be interpreted as a certificate.
+ **/
+int SoPlex_getDualFarkasReal(void* soplex, double* farkas, int dim);
